{
  "name": "freestruct",
  "version": "0.6.0",
  "description": "Post-build SEO layer for static doc sites - works with any SSG",
  "homepage": "https://github.com/dhaupin/freestruct#readme",
  "bugs": "https://github.com/dhaupin/freestruct/issues",
  "type": "module",
  "bin": {
    "freestruct": "./docs/lib/inject.js"
  },
  "files": [
    "docs/lib/",
    "docs/_freestruct/"
  ],
  "scripts": {
    "build": "cd docs && jekyll build && node lib/inject.js",
    "inject": "node docs/lib/inject.js",
    "test": "node test/run.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhaupin/freestruct.git"
  },
  "keywords": ["seo", "ssg", "static-site-generator", "docs", "jekyll", "hugo", "docusaurus", "search", "sitemap"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
