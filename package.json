{
  "name": "freestruct",
  "version": "1.0.0",
  "description": "Post-build SEO layer for static doc sites - works with any SSG",
  "homepage": "https://github.com/dhaupin/freestruct#readme",
  "bugs": "https://github.com/dhaupin/freestruct/issues",
  "type": "module",
  "main": "engine/inject.js",
  "bin": {
    "freestruct": "bin/freestruct.mjs"
  },
  "exports": {
    ".": "./engine/inject.js",
    "./bin": "./bin/freestruct.mjs",
    "./engine/*": "./engine/*",
    "./init/*": "./init/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "engine/",
    "init/",
    "!init/node_modules",
    "!init/dist"
  ],
  "scripts": {
    "build": "cd docs && jekyll build && cd .. && node bin/freestruct.mjs",
    "sync": "node scripts/sync-templates.mjs",
    "sync:check": "node scripts/sync-templates.mjs check",
    "inject": "node bin/freestruct.mjs",
    "test": "node test/run.js",
    "e2e": "node scripts/e2e-install.cjs",
    "lint:docs": "node scripts/run-docs-audit.cjs",
    "packs:selftest": "node scripts/packs-selftest.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhaupin/freestruct.git"
  },
  "keywords": [
    "seo",
    "ssg",
    "static-site-generator",
    "docs",
    "jekyll",
    "hugo",
    "docusaurus",
    "search",
    "sitemap"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^5.5.0"
  }
}
