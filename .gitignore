# --- build outputs ---
node_modules/
docs/node_modules/
docs/_site/

# --- toolchain caches that must never enter git ---
.npm/
*.tsbuildinfo

# --- env files (secrets never live in the repo; production uses deploy env) ---
.env
.env.*
!.env.example

